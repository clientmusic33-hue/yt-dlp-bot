# ============================================================================
# yt-dlp-bot - Render Deployment Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values
# Or set these directly in Render Dashboard

# -----------------------------------------------------------------------------
# COMMON VARIABLES (All Services)
# -----------------------------------------------------------------------------
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
PYTHONASYNCIODEBUG=0

# PostgreSQL Configuration
POSTGRES_USER=yt
POSTGRES_PASSWORD=CHANGE_ME_use_strong_password_here
POSTGRES_HOST=CHANGE_ME_render_postgres_hostname
POSTGRES_PORT=5432
POSTGRES_DB=yt
SQLALCHEMY_ECHO=False
SQLALCHEMY_EXPIRE_ON_COMMIT=False

# RabbitMQ Configuration
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=CHANGE_ME_render_rabbitmq_hostname
RABBITMQ_PORT=5672

# Redis Configuration
REDIS_HOST=CHANGE_ME_render_redis_hostname

# Storage Configuration
TMP_DOWNLOAD_ROOT_PATH=/tmp/download_tmpfs
TMP_DOWNLOAD_DIR=downloading
TMP_DOWNLOADED_DIR=downloaded
STORAGE_PATH=/filestorage

# Logging
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# API SERVICE VARIABLES
# -----------------------------------------------------------------------------
APPLICATION_NAME=yt_api
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# -----------------------------------------------------------------------------
# BOT SERVICE VARIABLES
# -----------------------------------------------------------------------------
APPLICATION_NAME=yt_bot
TG_MAX_MSG_SIZE=4096
TG_MAX_CAPTION_SIZE=1024

# -----------------------------------------------------------------------------
# WORKER SERVICE VARIABLES
# -----------------------------------------------------------------------------
APPLICATION_NAME=yt_worker
MAX_SIMULTANEOUS_DOWNLOADS=2
MAX_DOWNLOAD_THREADS=10
THUMBNAIL_FRAME_SECOND=10.0
INSTAGRAM_ENCODE_TO_H264=True
FACEBOOK_ENCODE_TO_H264=True

# -----------------------------------------------------------------------------
# TELEGRAM CONFIGURATION (Not env vars - go in app_bot/config.yml)
# -----------------------------------------------------------------------------
# Create app_bot/config.yml with these values:
# TELEGRAM_API_ID=your_api_id_from_my.telegram.org
# TELEGRAM_API_HASH=your_api_hash_from_my.telegram.org
# TELEGRAM_BOT_TOKEN=your_bot_token_from_BotFather
# YOUR_USER_ID=your_telegram_user_id
